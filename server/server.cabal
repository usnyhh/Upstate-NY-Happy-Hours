cabal-version:      3.0
name:               server
version:            0.1.0.0
synopsis:           Servant API backend for Upstate NY Happy Hours
build-type:         Simple

common shared
  ghc-options:
    -Wall
  default-language:
    Haskell2010

executable server
  import:           shared
  main-is:
    Main.hs
  hs-source-dirs:
    app
  other-modules:
    Api
  build-depends:
      aeson
    , base < 5
    , servant-server
    , text
    , wai-cors
    , warp
  ghc-options:
    -threaded -rtsopts -with-rtsopts=-N

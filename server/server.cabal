cabal-version:      3.0
name:               server
version:            0.1.0.0
synopsis:           Servant backend for Upstate NY Happy Hours
build-type:         Simple

executable server
  main-is:
    Main.hs
  hs-source-dirs:
    app
  build-depends:
      base < 5
    , filepath
    , http-types
    , servant-server
    , text
    , wai
    , wai-app-static
    , warp
  ghc-options:
    -Wall -threaded -rtsopts -with-rtsopts=-N
  default-language:
    Haskell2010
